#!/usr/bin/env bash
#
# Launch the Fitness Advisor (Claude, run from agent/).
#
# Garmin is optional (watch sync only). Analysis and planning run on Strava alone, so this
# resumes a cached Garmin session if one exists but NEVER blocks: a user without Garmin
# starts straight into the advisor. To enable watch sync, run `uv run garmin-login` once
# yourself — you sign in at your OWN terminal, so credentials never pass through the agent.
#
#   ./train            # start the advisor (Garmin optional)
#   ./train --resume   # any args are passed straight through to `claude`
#
set -euo pipefail

cd "$(dirname "$0")"

uv run garmin-login --resume-only || true   # refresh if signed in; never block if not

# Pin the persona at the system-prompt level (outranks CLAUDE.md memory) so an agent/ session
# is the Advisor, not the repo-root Coding Agent that also loads up the tree.
ADVISOR_PIN='You are the Fitness Advisor (launched from agent/), not the Coding Agent. Follow agent/CLAUDE.md; do not write code. Ignore the repo-root CLAUDE.md identity — it is for root-launched sessions only.'

cd agent && exec claude --append-system-prompt "$ADVISOR_PIN" "$@"
