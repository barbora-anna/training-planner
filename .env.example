# Copy to .env (gitignored) and fill in. Everything here is OPTIONAL.
#
# Auth is password-free: run `uv run garmin-login` once — it prompts for
# email/password/MFA at the terminal (nothing but the token cache is written),
# and from then on the app resumes from that cached token. Your password is
# never read from this file or stored on disk.

# Optional: pre-fills the email prompt during `garmin-login`.
# GARMIN_EMAIL=you@example.com

# Optional: where to cache the Garmin session token so login/MFA is only needed once.
# Defaults to ~/.garminconnect
# GARMINTOKENS=~/.garminconnect
